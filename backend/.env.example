# Database
MONGODB_URI=mongodb://localhost:27017/job-pulse

# Server
PORT=3000
NODE_ENV=development

# Public API URL (used in Swagger docs server dropdown)
# Set this in production to your deployed backend URL
API_BASE_URL=https://api.jobpulse.example.com

# Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars

# Redis (optional — omit to disable caching, app works fine without it)
# Uses cache-aside pattern: reads check Redis first, writes invalidate cache
# Supports redis:// (plain) and rediss:// (TLS, required for Upstash/cloud)
# REDIS_URL=redis://localhost:6379
# REDIS_URL=rediss://default:xxx@your-host.upstash.io:6379
# Set to false to temporarily disable caching even with REDIS_URL set
# REDIS_ENABLED=true

# APIs
SERPAPI_KEY=your_serpapi_key_here

# Admin API Key (protects /admin/ingest endpoint)
ADMIN_API_KEY=your-admin-api-key-here

# Scoring Weights (0-1)
RECENCY_WEIGHT=0.6
RELEVANCE_WEIGHT=0.4

# Refresh intervals (in hours)
FETCH_INTERVAL_HOURS=3

# Cron schedules (node-cron format)
# INGEST_CRON_EXPRESSION=0 45 14 * * *
# NOTIFICATION_CLEANUP_CRON_EXPRESSION=25 15 * * *

# ========================================
# Job Ingestion API Cost Optimization
# ========================================
# SerpAPI Budget: 240 requests/month (free tier)
# Cost: 1 request = ~10 jobs
# Formula: (MAX_JOBS_PER_QUERY) × num_queries × num_countries ÷ 10 = requests_per_run
#
# Examples:
# - 50 jobs × 5 queries × 1 country = 25 requests/run
# - 20 jobs × 3 queries × 1 country = 6 requests/run

# Maximum jobs per search query (default: 20)
MAX_JOBS_PER_QUERY=20

# Countries to fetch from (comma-separated)
COUNTRIES_TO_FETCH=India

# Search queries to rotate (comma-separated)
SEARCH_QUERIES=software engineer,software developer,backend developer,full stack developer,sde

# Include free Remotive API (default: true, no cost/no limit)
INCLUDE_REMOTIVE=true

# Include Google Jobs via SerpAPI (default: true, costs credits)
INCLUDE_GOOGLE_JOBS=true

# ========================================
# AI Resume Analyzer Configuration
# ========================================
# Provider: groq (free tier recommended)
AI_PROVIDER=groq

# Groq API Key (FREE tier)
# Get yours at: https://console.groq.com/keys
# Free limits:
#   - 30 requests/minute
#   - 14,400 requests/day
# 
# Model fallback hierarchy (automatic):
#   1. llama-3.3-70b-versatile (best quality)
#   2. llama-4-scout-17b (good quality)  
#   3. llama-3.1-8b-instant (fastest, basic)
#
# Estimated capacity: ~200-300 resume analyses/day
GROQ_API_KEY=your_groq_api_key_here

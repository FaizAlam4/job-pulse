# Backend API URL
# Development: http://localhost:3000
# Production: your deployed backend URL (e.g. Render)
NEXT_PUBLIC_API_URL=http://localhost:3000

# Frontend App URL (used for PWA manifest detection)
# Development: http://localhost:3005
# Production: your deployed frontend URL (e.g. Vercel)
NEXT_PUBLIC_APP_URL=http://localhost:3005

# NOTE: NODE_ENV is set automatically by Next.js — do NOT set it here
# - `next dev`   → NODE_ENV=development  (service worker disabled)
# - `next build` + `next start` → NODE_ENV=production  (service worker enabled)

# Optional: Disable PWA service worker even in production
# NEXT_PUBLIC_DISABLE_PWA=true
